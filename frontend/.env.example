# Use the supplied Egypt files locally, "real" for the NASA API, or "synthetic" for fake demo data.
VITE_FIRMS_DATA_MODE=local

# Optional base path for static hosting under a repository subpath (for example, GitHub Pages).
VITE_BASE_PATH=/

# Optional URL for the deployed Parquet/DuckDB API. Leave empty for same-origin/local Vite data.
VITE_LOCAL_FIRMS_API_URL=

# Set to the Hugging Face dataset repository's public "resolve/main" URL to query Parquet in-browser.
# Example: https://huggingface.co/datasets/your-name/firms-data/resolve/main
# When set, the frontend runs DuckDB-Wasm locally and does not need the Python API.
VITE_FIRMS_PARQUET_BASE_URL=

# Optional shared backend URL for deployed FIRMS, harmonized, and AI endpoints.
# Leave empty to keep same-origin development/proxy behavior.
VITE_BACKEND_API_URL=

# Request a NASA FIRMS MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Store your replacement key in frontend/.env.local (never in VITE_* variables).
NASA_FIRMS_MAP_KEY=replace_with_your_nasa_firms_map_key

# COSMO requests are proxied by the Vite server; never use a VITE_ prefix.
COSMO_API_KEY=replace_with_your_cosmo_api_key